# Offline Survival Computer – Environment Variables
# Copy this file to .env and edit the values before starting

# ---- Web App ----
# Random secret key for Flask sessions. Change this in production!
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ---- Authentication ----
# Admin login credentials
# To generate password hash, run: python3 app/create_admin.py
# Or use: python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2:sha256:600000$CHANGE_THIS_HASH

# Host ports for the services (change if these ports are already in use)
APP_PORT=5000
KIWIX_PORT=8080
OLLAMA_PORT=11434

# ---- Maps ----
# Leave as-is to use live OpenStreetMap tiles (requires internet).
# For fully offline use, serve local tiles and set this to the tile server URL.
# Example: http://localhost:8081/{z}/{x}/{y}.png
MAPS_TILE_URL=/tiles/{z}/{x}/{y}.png
